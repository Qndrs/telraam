msgid "Qndrs Telraam Inzicht requires PHP %1$s or higher. Your server is running PHP %2$s."
msgstr "Qndrs Telraam Inzicht vereist PHP %1$s of hoger. Je server draait PHP %2$s."

msgid "Qndrs Telraam Inzicht activation failed"
msgstr "Qndrs Telraam Inzicht activeren is mislukt"

msgid "Qndrs Telraam Inzicht requires PHP %1$s or higher. Your server is running PHP %2$s. The plugin has not been loaded."
msgstr "Qndrs Telraam Inzicht vereist PHP %1$s of hoger. Je server draait PHP %2$s. De plugin is niet geladen."

msgid "Qndrs Telraam Inzicht"
msgstr "Qndrs Telraam Inzicht"

msgid "Telraam API"
msgstr "Telraam API"

msgid "API token"
msgstr "API-token"

msgid "Default segment ID"
msgstr "Standaard segment-ID"

msgid "Default period"
msgstr "Standaardperiode"

msgid "Cache duration"
msgstr "Cacheduur"

msgid "You do not have permission to manage Telraam settings."
msgstr "Je hebt geen toestemming om Telraam-instellingen te beheren."

msgid "Configure the Telraam API connection and default display settings for traffic statistics."
msgstr "Configureer de Telraam API-verbinding en standaard weergave-instellingen voor verkeersstatistieken."

msgid "Save settings"
msgstr "Instellingen opslaan"

msgid "Cache"
msgstr "Cache"

msgid "Clear cached traffic data for the currently configured default segment and period."
msgstr "Wis gecachte verkeersdata voor het momenteel ingestelde standaardsegment en de standaardperiode."

msgid "Clear cache"
msgstr "Cache wissen"

msgid "You do not have permission to clear the Telraam cache."
msgstr "Je hebt geen toestemming om de Telraam-cache te wissen."

msgid "The Telraam cache has been cleared."
msgstr "De Telraam-cache is gewist."

msgid "Enter your Telraam API token and choose sensible defaults for frontend shortcodes."
msgstr "Voer je Telraam API-token in en kies verstandige standaardwaarden voor frontend-shortcodes."

msgid "An API token is currently saved. Leave this field empty to keep the existing token."
msgstr "Er is momenteel een API-token opgeslagen. Laat dit veld leeg om het bestaande token te behouden."

msgid "Paste your Telraam API token. It will not be shown on the frontend."
msgstr "Plak je Telraam API-token. Het wordt niet op de frontend getoond."

msgid "Default Telraam segment ID used when a shortcode does not specify an ID."
msgstr "Standaard Telraam segment-ID dat wordt gebruikt wanneer een shortcode geen ID opgeeft."

msgid "days"
msgstr "dagen"

msgid "Traffic report requests are limited to a maximum period of 90 days."
msgstr "Traffic report requests zijn beperkt tot een maximale periode van 90 dagen."

msgid "minutes"
msgstr "minuten"

msgid "Caching protects your Telraam API quota. The Telraam API allows limited request rates."
msgstr "Caching beschermt je Telraam API-quota. De Telraam API staat beperkte request-aantallen toe."

msgid "The Telraam API token is missing."
msgstr "Het Telraam API-token ontbreekt."

msgid "The Telraam segment ID is missing."
msgstr "Het Telraam segment-ID ontbreekt."

msgid "The Telraam API request failed."
msgstr "De Telraam API-request is mislukt."

msgid "The Telraam API returned an unexpected HTTP status: %d."
msgstr "De Telraam API gaf een onverwachte HTTP-status terug: %d."

msgid "The Telraam API returned invalid JSON."
msgstr "De Telraam API gaf ongeldige JSON terug."

msgid "No Telraam segment ID was provided."
msgstr "Er is geen Telraam segment-ID opgegeven."

msgid "Telraam"
msgstr "Telraam"

msgid "Segment %1$s, last %2$d days."
msgstr "Segment %1$s, laatste %2$d dagen."

msgid "Segment %s, last day."
msgstr "Segment %s, laatste dag."

msgid "Traffic totals"
msgstr "Verkeerstotalen"

msgid "Hourly traffic rows for segment %s, last day."
msgstr "Verkeersregels per uur voor segment %s, laatste dag."

msgid "Hourly traffic rows for segment %1$s, last %2$d days."
msgstr "Verkeersregels per uur voor segment %1$s, laatste %2$d dagen."

msgid "%1$s Showing %2$d of %3$d rows."
msgstr "%1$s Toont %2$d van %3$d regels."

msgid "Pedestrians"
msgstr "Voetgangers"

msgid "Two-wheelers"
msgstr "Tweewielers"

msgid "Cars"
msgstr "Auto’s"

msgid "Heavy vehicles"
msgstr "Zwaar verkeer"

msgid "Night traffic"
msgstr "Nachtverkeer"

msgid "No traffic rows were returned by the Telraam API."
msgstr "De Telraam API gaf geen verkeersregels terug."

msgid "Time"
msgstr "Tijd"

msgid "Uptime"
msgstr "Uptime"

msgid "Night"
msgstr "Nacht"

msgid "Unknown"
msgstr "Onbekend"

msgid "%s%%"
msgstr "%s%%"

msgid "API connection test"
msgstr "API-verbindingstest"

msgid "Test the saved API token and default segment with a one-day traffic report request."
msgstr "Test het opgeslagen API-token en standaardsegment met een verkeersrapportrequest van één dag."

msgid "Test API connection"
msgstr "API-verbinding testen"

msgid "You do not have permission to test the Telraam API connection."
msgstr "Je hebt geen toestemming om de Telraam API-verbinding te testen."

msgid "The Telraam API connection works. The test returned %d traffic rows."
msgstr "De Telraam API-verbinding werkt. De test gaf %d verkeersregels terug."

msgid "The Telraam API connection test failed: %s"
msgstr "De Telraam API-verbindingstest is mislukt: %s"

msgid "Unknown error."
msgstr "Onbekende fout."

msgid "API token status:"
msgstr "API-tokenstatus:"

msgid "API token saved"
msgstr "API-token opgeslagen"

msgid "API token saved."
msgstr "API-token opgeslagen."

msgid "No API token saved"
msgstr "Geen API-token opgeslagen"

msgid "No API token saved."
msgstr "Geen API-token opgeslagen."

msgid "API token management"
msgstr "API-tokenbeheer"

msgid "Remove the saved Telraam API token from this WordPress site. This does not revoke the token in Telraam."
msgstr "Verwijder het opgeslagen Telraam API-token van deze WordPress-site. Dit trekt het token niet in bij Telraam."

msgid "Clear API token"
msgstr "API-token wissen"

msgid "You do not have permission to clear the Telraam API token."
msgstr "Je hebt geen toestemming om het Telraam API-token te wissen."

msgid "The Telraam API token has been cleared."
msgstr "Het Telraam API-token is gewist."
